{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/",
      "destination": "https://covecollect.com/insights",
      "permanent": true
    },
    {
      "source": "/:slug/",
      "destination": "https://covecollect.com/insights/:slug",
      "permanent": true
    },
    {
      "source": "/:slug",
      "destination": "https://covecollect.com/insights/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://covecollect.com/insights",
      "permanent": true
    }
  ]
}
